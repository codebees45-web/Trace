# development | staging | production — "production" turns on strict startup
# checks (JWT_SECRET must be changed, must be 32+ chars) and HSTS headers.
ENVIRONMENT=development
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./trace.db
ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.com
FRONTEND_URL=http://localhost:5173
CONFIDENCE_THRESHOLD=0.4
PIPELINE_PATH=masked_face_pipeline.joblib
ENABLE_GENERATION=true
SD_MODEL_ID=runwayml/stable-diffusion-inpainting
SD_INFERENCE_STEPS=15
SD_GUIDANCE_SCALE=7.5
MAX_UPLOAD_MB=8
PREDICT_RATE_LIMIT=10/minute
AUTH_RATE_LIMIT=5/minute
LOG_LEVEL=INFO
SQLITE_BUSY_TIMEOUT_MS=5000